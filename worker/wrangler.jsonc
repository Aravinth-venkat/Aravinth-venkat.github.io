{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "careerlab-ai",
  "main": "worker.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": true,
  "vars": {
    "MODEL": "gpt-5.6",
    "ALLOWED_ORIGIN": "https://aravinth-venkat.github.io"
  },
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  }
}
